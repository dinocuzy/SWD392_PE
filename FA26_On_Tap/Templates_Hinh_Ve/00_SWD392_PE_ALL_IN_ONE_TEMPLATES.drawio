  <diagram id="design-patterns-pe" name="Part3_4_Design_Patterns_Templates"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="dp1_box" value="&lt;b&gt;1. OBSERVER PATTERN (BEHAVIORAL - ĐỀ SU25 CINEMA &amp;amp; CYBER AI)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="750" height="450" as="geometry" /></mxCell><mxCell id="obs_subj" value="&lt;p style=&quot;text-align:center;margin:4px 0;&quot;&gt;&lt;b&gt;ShowtimeSubject (Subject)&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:4px 0;&quot;&gt;- notifications: List&amp;lt;Notification&amp;gt;&lt;br&gt;- movieTitle: String&lt;br&gt;- showTime: String&lt;br&gt;- availableSeat: int&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:4px 0;&quot;&gt;+ addNotification(n: Notification): void&lt;br&gt;+ removeNotification(n: Notification): void&lt;br&gt;+ notifyNotifications(): void&lt;br&gt;+ updateShowtime(title, time, seat): void&lt;/p&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="dp1_box"><mxGeometry x="30" y="60" width="280" height="190" as="geometry" /></mxCell><mxCell id="obs_intf" value="&lt;p style=&quot;text-align:center;margin:4px 0;&quot;&gt;&lt;i&gt;&amp;laquo;interface&amp;raquo;&lt;/i&gt;&lt;br&gt;&lt;b&gt;Notification (Observer)&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:4px 0;&quot;&gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:4px 0;&quot;&gt;+ update(movieTitle: String, showTime: String, availableSeat: int): void&lt;/p&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="dp1_box"><mxGeometry x="420" y="60" width="290" height="125" as="geometry" /></mxCell><mxCell id="obs_conc" value="&lt;p style=&quot;text-align:center;margin:4px 0;&quot;&gt;&lt;b&gt;CustomerNotification&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:4px 0;&quot;&gt;- customerEmail: String&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:4px 0;&quot;&gt;+ update(movieTitle: String, showTime: String, availableSeat: int): void&lt;/p&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#000000;fontSize=12;" vertex="1" parent="dp1_box"><mxGeometry x="420" y="270" width="290" height="130" as="geometry" /></mxCell><mxCell id="obs_e1" value="notifies (1 to 0..*)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=diamondThin;startFill=0;startSize=14;endArrow=open;endFill=0;strokeWidth=1.5;" edge="1" parent="dp1_box" source="obs_subj" target="obs_intf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="obs_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=8 8;endArrow=block;endFill=0;endSize=12;strokeWidth=1.5;" edge="1" parent="dp1_box" source="obs_conc" target="obs_intf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dp2_box" value="&lt;b&gt;2. STRATEGY PATTERN (BEHAVIORAL - ĐỀ SU25 FLOWER SHOP)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="830" y="30" width="780" height="450" as="geometry" /></mxCell><mxCell id="str_ctx" value="&lt;p style=&quot;text-align:center;margin:4px 0;&quot;&gt;&lt;b&gt;FlowerOrder (Context)&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:4px 0;&quot;&gt;- pricing: Pricing&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:4px 0;&quot;&gt;+ setPricing(p: Pricing): void&lt;br&gt;+ calculateOrderTotal(basePrice, qty, type): double&lt;/p&gt;" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#000000;fo