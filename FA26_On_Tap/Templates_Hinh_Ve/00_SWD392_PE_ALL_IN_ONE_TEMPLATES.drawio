ometry" /></mxCell><mxCell id="le_r3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;startSize=14;endSize=12;" edge="1" parent="1" source="le_detail" target="le_item"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="le_r4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERoneToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeWidth=1.5;startSize=14;endSize=12;" edge="1" parent="1" source="le_item" target="le_prov"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
